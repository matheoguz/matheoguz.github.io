# Clé fal.ai (https://fal.ai/dashboard/keys) — sert pour l'image, la voix et l'animation
FAL_KEY=

# Stripe (https://dashboard.stripe.com/apikeys) — clé SECRÈTE, jamais dans le site
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (whsec_...), donné quand tu crées le webhook
STRIPE_WEBHOOK_SECRET=

# Base Redis (Upstash, ajoutée automatiquement par Vercel > Storage > Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Adresse de la page du site (retour après paiement)
SITE_URL=https://matheoguz.github.io/fruits/
# Origine autorisée à appeler l'API
ALLOWED_ORIGIN=https://matheoguz.github.io

# Crédits offerts à un nouveau visiteur (0 conseillé : chaque vidéo te coûte de l'argent)
FREE_CREDITS=0
